# GEMINI_API_KEY: Required for Gemini AI API calls (server-side decision support).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform, Places, and routing.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# GEMINI_MODEL: Configurable Gemini model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# FIREBASE CONFIGURATION (Optional - system runs with full demo persistence if omitted)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

